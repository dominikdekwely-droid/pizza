-- ==========================================

-- 1. Вопрос: Какие сотрудники работают на должности 'manager' или 'chef' и были приняты на работу после 1 мая 2023 года? 
-- (Используется: WHERE с AND/OR, ORDER BY)
SELECT id, first_name, last_name, role, hired_at 
FROM employees 
WHERE (role = 'manager' OR role = 'chef') AND hired_at > '2023-05-01'
ORDER BY hired_at DESC;

-- 2. Вопрос: Какие клиенты проживают по адресам, содержащим слово 'Ленина' или 'Пушкина'?
-- (Используется: WHERE с OR, LIKE)
SELECT first_name, last_name, phone, address 
FROM customers 
WHERE address LIKE '%Ленина%' OR address LIKE '%Пушкина%';

-- 3. Вопрос: Вывести уникальные роли сотрудников, которые есть в пиццерии, чтобы понять структуру штата.
-- (Используется: DISTINCT)
SELECT DISTINCT role 
FROM employees 
ORDER BY role;

-- 4. Вопрос: Найти всех курьеров, у которых не указан номер телефона в базе (поле пустое).
-- (Используется: IS NULL, WHERE)
SELECT id, first_name, last_name, role 
FROM employees 
WHERE phone IS NULL AND role = 'courier';

-- 5. Вопрос: Вывести список продуктов, их базовую цену, и рассчитать стоимость с наценкой 15%. Вывести только те, что стоят от 400 до 800 рублей.
-- (Используется: BETWEEN, вычисляемый столбец)
SELECT name, base_price, 
       ROUND(base_price * 1.15, 2) AS price_with_markup 
FROM products 
WHERE base_price BETWEEN 400 AND 800
ORDER BY base_price;
